    data_csv = "/project/verma_shared/projects/Liver_IDPs/covariates/hepatic_fat_pheno_SL_transformed_EUR_AFR.csv"
    cohort_sets = "/static/PMBB/PMBB-Release-2026-4.0/Exome/PCA/combined/PMBB-Release-2026-4.0_genetic_exome.commonsnps.ohe_cohort_sets.csv"
    step1_plink_prefix = "/static/PMBB/PMBB-Release-2026-4.0/Imputed/common_snps_LD_pruned/PMBB-Release-2026-4.0_genetic_imputed.commonsnps.ldpruned.ALL"
    ftype = "PLINK2"

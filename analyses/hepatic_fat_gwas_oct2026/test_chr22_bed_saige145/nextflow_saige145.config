profiles {
    cluster_singularity {
        process.executor = 'lsf'
        process.queue = 'epistasis_normal'
        process.memory = '15GB'
        process.beforeScript = 'module load apptainer/1.5.3'
        process.container = '/project/verma_shared/projects/Liver_IDPs/tools/pmbb-nf-toolkit-saige-family/saige.sif'
        apptainer.enabled = true
        apptainer.runOptions = '-B /home/,/project/,/static/'
        executor {
            queueSize = 500
        }
    }
}

params {
    skip_postprocessing_errors = false
}

process {
    withLabel: safe_to_skip {
        errorStrategy = params.skip_postprocessing_errors ? 'ignore' : 'terminate'
    }
}
